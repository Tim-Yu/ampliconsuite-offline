#!/usr/bin/env bash
#BSUB -q medium
#BSUB -P re_gecip_cancer_sarcoma
#BSUB -J ampsuite[1-2]
#BSUB -o logs/ampsuite.%J.%I.out
#BSUB -e logs/ampsuite.%J.%I.err
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=32000]"
#BSUB -n 16
#BSUB -W 24:00
#
# Job array: one AmpliconSuite run per line of SAMPLES_TSV (tab-separated: sample  tumour_bam  [normal_bam]).
# Edit the array range [1-N] to the number of data lines, then:
#   cd /re_gecip/cancer_sarcoma/<project>/ampliconsuite && mkdir -p logs
#   bsub -env "all,SAMPLES_TSV=hpc/samples.tsv" < hpc/submit_ampsuite_array.lsf
set -euo pipefail
module load singularity/4.1.1

AMPSUITE_ROOT="${AMPSUITE_ROOT:-$(pwd)}"
# shellcheck disable=SC1091
source "$AMPSUITE_ROOT/env_controlled.sh"
SAMPLES_TSV="${SAMPLES_TSV:-$AMPSUITE_ROOT/hpc/samples.tsv}"
line="$(grep -v '^#' "$SAMPLES_TSV" | sed -n "${LSB_JOBINDEX}p")"
[[ -n "$line" ]] || { echo "no sample at index $LSB_JOBINDEX in $SAMPLES_TSV"; exit 1; }
IFS=$'\t' read -r SAMPLE BAM NORMAL_BAM <<< "$line"
THREADS="${THREADS:-${LSB_DJOB_NUMPROC:-16}}"
OUTDIR="${OUTDIR_ROOT:-$AMPSUITE_ROOT/runs}/$SAMPLE"
mkdir -p "$OUTDIR" logs
args=(-s "$SAMPLE" -t "$THREADS" --bam "$BAM" --ref "${REF:-GRCh38}" --run_AA --run_AC -o "$OUTDIR")
[[ -n "${NORMAL_BAM:-}" ]] && args+=(--normal_bam "$NORMAL_BAM")
# shellcheck disable=SC2206
[[ -n "${EXTRA_ARGS:-}" ]] && args+=(${EXTRA_ARGS})
echo "[$(date)] [$LSB_JOBINDEX] run_ampsuite.sh ${args[*]}"
run_ampsuite.sh "${args[@]}"
echo "[$(date)] [$LSB_JOBINDEX] done -> $OUTDIR"
