#!/usr/bin/env bash
#BSUB -q medium
#BSUB -P re_gecip_cancer_sarcoma
#BSUB -J ampsuite[1-1]
#BSUB -o logs/ampsuite.%J.%I.out
#BSUB -e logs/ampsuite.%J.%I.err
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=32000]"
#BSUB -n 16
#BSUB -W 24:00
#
# AmpliconSuite on a whole cohort from the sample sheet (header: PatientID, TumourID, Tumour_BAM, Normal_BAM;
# tab or comma separated; paths may be .bam or .cram, column names Tumour_CRAM/Normal_CRAM also accepted). ONE file, two modes:
#   on the login node:  bash hpc/ampsuite_cohort.lsf /path/sample_sheet.tsv [outdir_root]
#        -> checks every BAM, then submits THIS file as an LSF array "ampsuite[1-N]" (one element per tumour)
#   inside LSF:         each array element processes row $LSB_JOBINDEX of the sheet with run_ampsuite.sh
# Results: <outdir_root>/<TumourID>/ (default <restore dest>/runs/<TumourID>/); afterwards run
#   bash hpc/ampsuite_cohort_classify.lsf /path/sample_sheet.tsv [outdir_root]   for one cohort-level table.
# Optional env at submission: QUEUE (medium) and WALLTIME (24:00), e.g. QUEUE=short WALLTIME=4:00 bash hpc/ampsuite_cohort.lsf sheet.tsv;
#   REF (GRCh38), EXTRA_ARGS (e.g. "--no_QC"), THREADS; DRY_RUN=1 prints the bsub command instead of submitting.
#   CRAM inputs: the reference cache built by hpc/build_cram_cache.lsf (default <restore dest>/cram_ref_cache, or CRAM_CACHE=DIR) is required.
set -euo pipefail
AMPSUITE_ROOT="${AMPSUITE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# shellcheck disable=SC1091
source "$AMPSUITE_ROOT/hpc/sheet_lib.sh"

if [[ -z "${LSB_JOBID:-}" ]]; then
  # ---------------- submit mode (login node) ----------------
  SHEET="${1:-${SHEET:-}}"; OUTDIR_ROOT="${2:-${OUTDIR_ROOT:-$AMPSUITE_ROOT/runs}}"
  [[ -n "$SHEET" && -f "$SHEET" ]] || { echo "usage: bash $0 /path/sample_sheet.tsv [outdir_root]" >&2; exit 1; }
  SHEET="$(realpath "$SHEET")"; mkdir -p "$OUTDIR_ROOT" "$AMPSUITE_ROOT/logs"; OUTDIR_ROOT="$(realpath "$OUTDIR_ROOT")"
  N="$(sheet_count "$SHEET")"; echo "sheet: $SHEET ($N tumours) -> $OUTDIR_ROOT"; bad=0; any_cram=0
  has_index() { local f="$1"; if [[ "${f,,}" == *.cram ]]; then [[ -f "$f.crai" || -f "${f%.cram}.crai" ]]; else [[ -f "$f.bai" || -f "${f%.bam}.bai" ]]; fi; }
  while IFS= read -r row; do
    tid="$(sheet_field "$row" 1)"; tbam="$(sheet_field "$row" 2)"; nbam="$(sheet_field "$row" 3)"; pid="$(sheet_field "$row" 4)"; st="ok"
    [[ -f "$tbam" ]] || { st="MISSING tumour file $tbam"; bad=1; }
    [[ -z "$nbam" || -f "$nbam" ]] || { st="MISSING normal file $nbam"; bad=1; }
    [[ -f "$tbam" ]] && ! has_index "$tbam" && st="$st (no index next to the tumour file)"
    [[ "${tbam,,}" == *.cram || "${nbam,,}" == *.cram ]] && { any_cram=1; st="$st [CRAM]"; }
    [[ -z "$nbam" ]] && st="$st (no normal: CNVkit uses the built-in reference)"
    [[ -f "$OUTDIR_ROOT/$tid/${tid}_finish_flag.txt" ]] && st="$st (already finished, will be rerun)"
    printf '  %-12s %-24s %s\n' "$pid" "$tid" "$st"
  done < <(sheet_rows "$SHEET")
  [[ $bad -eq 0 ]] || { echo "ERROR: fix the missing files above, then resubmit" >&2; exit 1; }
  if [[ $any_cram -eq 1 ]]; then
    CRAM_CACHE="${CRAM_CACHE:-$AMPSUITE_ROOT/cram_ref_cache}"
    if [[ ! -d "$CRAM_CACHE" ]] || [[ -z "$(find "$CRAM_CACHE" -type f -print -quit 2>/dev/null)" ]]; then
      echo "ERROR: CRAM inputs need the htslib reference cache, and $CRAM_CACHE is empty or missing." >&2
      echo "       Build it once from the FASTA the CRAMs were aligned to:  bash hpc/build_cram_cache.lsf /path/reference.fa /path/one.cram" >&2
      echo "       (or point CRAM_CACHE=/existing/cache/dir)" >&2; exit 1
    fi
    echo "CRAM inputs detected: reference cache $CRAM_CACHE ($(find "$CRAM_CACHE" -type f | wc -l) sequences). CRAM decoding makes CNVkit several times slower than BAM: keep the medium queue."
  else CRAM_CACHE=""; fi
  cd "$AMPSUITE_ROOT"
  export SHEET OUTDIR_ROOT AMPSUITE_ROOT REF EXTRA_ARGS THREADS CRAM_CACHE
  lsf_submit "${QUEUE:-medium}" "${WALLTIME:-24:00}" "$(lsf_env SHEET OUTDIR_ROOT AMPSUITE_ROOT REF EXTRA_ARGS THREADS CRAM_CACHE)" "${BASH_SOURCE[0]}" -J "ampsuite[1-$N]"
  exit 0
fi

# ---------------- run mode (one array element) ----------------
type module >/dev/null 2>&1 && module load singularity/4.1.1
# shellcheck disable=SC1091
source "$AMPSUITE_ROOT/env_controlled.sh"
: "${SHEET:?SHEET not set}"; OUTDIR_ROOT="${OUTDIR_ROOT:-$AMPSUITE_ROOT/runs}"
[[ -n "${CRAM_CACHE:-}" ]] && export REF_CACHE="$CRAM_CACHE/%2s/%2s/%s"     # picked up by run_ampsuite.sh for .cram inputs
row="$(sheet_row "$SHEET" "${LSB_JOBINDEX:-1}")"; [[ -n "$row" ]] || { echo "no row ${LSB_JOBINDEX:-1} in $SHEET"; exit 1; }
TUMOUR_ID="$(sheet_field "$row" 1)"; TUMOUR_BAM="$(sheet_field "$row" 2)"; NORMAL_BAM="$(sheet_field "$row" 3)"; PATIENT_ID="$(sheet_field "$row" 4)"
OUTDIR="$OUTDIR_ROOT/$TUMOUR_ID"; mkdir -p "$OUTDIR"
printf 'PatientID\t%s\nTumourID\t%s\nTumour_BAM\t%s\nNormal_BAM\t%s\n' "$PATIENT_ID" "$TUMOUR_ID" "$TUMOUR_BAM" "$NORMAL_BAM" > "$OUTDIR/sample_info.tsv"
args=(-s "$TUMOUR_ID" -t "${THREADS:-${LSB_DJOB_NUMPROC:-16}}" --bam "$TUMOUR_BAM" --ref "${REF:-GRCh38}" --run_AA --run_AC -o "$OUTDIR")
[[ -n "$NORMAL_BAM" ]] && args+=(--normal_bam "$NORMAL_BAM")
# shellcheck disable=SC2206
[[ -n "${EXTRA_ARGS:-}" ]] && args+=(${EXTRA_ARGS})
echo "[$(date)] element ${LSB_JOBINDEX:-1}: patient $PATIENT_ID tumour $TUMOUR_ID"; echo "[$(date)] run_ampsuite.sh ${args[*]}"
run_ampsuite.sh "${args[@]}"
echo "[$(date)] done -> $OUTDIR"
